--====================================================
-- MODEL SCAN
--====================================================

local scanTimer = 0

local function scanESP()
    local models = {}

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= Player and otherPlayer.Character then
            table.insert(models, otherPlayer.Character)
        end
    end

    for _, model in ipairs(Workspace:GetDescendants()) do
        if model:IsA("Model")
            and model ~= Character
            and not Players:GetPlayerFromCharacter(model) then

            local hum = getHumanoid(model)
            local root = getRoot(model)

            if hum and root and hum.Health > 0 then
                table.insert(models, model)
            end
        end
    end

    for _, model in ipairs(models) do
        if not ESPObjects[model] then
            createESP(model)
        end
    end
end

--====================================================
-- MAIN LOOP
--====================================================

RunService.RenderStepped:Connect(function(dt)
    local camera = Workspace.CurrentCamera

    if Humanoid and Humanoid.Parent then
        Humanoid.WalkSpeed = S.WalkSpeed
    end

    UpButton.Visible = S.Fly
    DownButton.Visible = S.Fly

    -- AIM ASSIST
    local target

    if S.NPCAim then
        target = findTarget(false)
    elseif S.PlayerAim then
        target = findTarget(true)
    end

    if target then
        local root = getRoot(target)

        if root then
            local goal = CFrame.lookAt(
                camera.CFrame.Position,
                root.Position
            )

            local alpha

            if S.SmoothCamera then
                alpha = 1 - math.exp(
                    -(S.AimStrength / 100 * 12) * dt
                )
            else
                alpha = S.AimStrength / 100
            end

            camera.CFrame = camera.CFrame:Lerp(goal, alpha)
        end
    end

    -- ESP
    local active = S.BoxESP or S.HealthESP
        or S.OutlineESP or S.TracerESP

    scanTimer += dt

    if active and scanTimer >= 1 then
        scanTimer = 0
        scanESP()
    end

    for model, data in pairs(ESPObjects) do
        if not active or not model.Parent then
            removeESP(model)
        else
            updateESP(model, data)
        end
    end
end)

