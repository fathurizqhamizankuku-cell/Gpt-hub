--====================================================
-- AIM HELPERS
--====================================================

local function getHumanoid(model)
    return model:FindFirstChildOfClass("Humanoid")
end

local function getRoot(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
end

local function canSee(model)
    if not S.WallCheck then return true end

    local root = getRoot(model)
    if not root then return false end

    local camera = Workspace.CurrentCamera
    local params = RaycastParams.new()

    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {Character}

    local origin = camera.CFrame.Position
    local result = Workspace:Raycast(
        origin,
        root.Position - origin,
        params
    )

    return result == nil or result.Instance:IsDescendantOf(model)
end

local function findTarget(wantPlayers)
    local camera = Workspace.CurrentCamera
    local center = camera.ViewportSize / 2

    local best
    local bestDistance = S.FOV

    for _, model in ipairs(Workspace:GetDescendants()) do
        if model:IsA("Model") and model ~= Character then
            local hum = getHumanoid(model)
            local root = getRoot(model)
            local targetPlayer = Players:GetPlayerFromCharacter(model)

            local isPlayer = targetPlayer ~= nil
            local allowed

            if wantPlayers then
                allowed = isPlayer and targetPlayer ~= Player
            else
                allowed = not isPlayer
            end

            if allowed and hum and hum.Health > 0 and root then
                local distance =
                    (root.Position - camera.CFrame.Position).Magnitude

                if distance <= S.AimRange and canSee(model) then
                    local point, onScreen =
                        camera:WorldToViewportPoint(root.Position)

                    if onScreen then
                        local screenDistance = (
                            Vector2.new(point.X, point.Y) - center
                        ).Magnitude

                        if screenDistance < bestDistance then
                            bestDistance = screenDistance
                            best = model
                        end
                    end
                end
            end
        end
    end

    return best
end

