local ESPGui = Instance.new("ScreenGui")
ESPGui.Name = "GPT_ESP"
ESPGui.ResetOnSpawn = false
ESPGui.IgnoreGuiInset = true
ESPGui.DisplayOrder = 10
ESPGui.Parent = PlayerGui

local ESPObjects = {}

local function createLine(parent)
    local line = Instance.new("Frame")
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Parent = parent
    return line
end

local function createESP(model)
    if ESPObjects[model] then return end

    local folder = Instance.new("Frame")
    folder.BackgroundTransparency = 1
    folder.Size = UDim2.fromScale(1, 1)
    folder.Parent = ESPGui

    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Parent = folder

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Parent = box

    local healthBack = Instance.new("Frame")
    healthBack.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    healthBack.BorderSizePixel = 0
    healthBack.Parent = folder

    local health = Instance.new("Frame")
    health.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    health.BorderSizePixel = 0
    health.AnchorPoint = Vector2.new(0, 1)
    health.Position = UDim2.new(0, 0, 1, 0)
    health.Parent = healthBack

    local tracer = createLine(folder)

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = false
    highlight.Parent = model

    ESPObjects[model] = {
        Folder = folder,
        Box = box,
        Stroke = stroke,
        HealthBack = healthBack,
        Health = health,
        Tracer = tracer,
        Highlight = highlight
    }
end

local function removeESP(model)
    local data = ESPObjects[model]
    if not data then return end

    data.Folder:Destroy()
    data.Highlight:Destroy()
    ESPObjects[model] = nil
end

local function updateESP(model, data)
    local hum = getHumanoid(model)
    local root = getRoot(model)

    if not hum or not root or hum.Health <= 0 then
        data.Folder.Visible = false
        return
    end

    local camera = Workspace.CurrentCamera
    local cf, size = model:GetBoundingBox()

    local top = camera:WorldToViewportPoint(
        cf.Position + Vector3.new(0, size.Y / 2, 0)
    )

    local bottom = camera:WorldToViewportPoint(
        cf.Position - Vector3.new(0, size.Y / 2, 0)
    )

    local visible = top.Z > 0 and bottom.Z > 0
    data.Folder.Visible = visible

    if not visible then return end

    local height = math.abs(bottom.Y - top.Y)
    local width = math.max(height * 0.48, 4)
    local x = top.X - width / 2
    local y = math.min(top.Y, bottom.Y)

    -- 2D BOX
    data.Box.Visible = S.BoxESP
    data.Box.Position = UDim2.fromOffset(x, y)
    data.Box.Size = UDim2.fromOffset(width, height)
    data.Stroke.Color = S.ESPColor

    -- HEALTH
    data.HealthBack.Visible = S.HealthESP
    data.HealthBack.Position = UDim2.fromOffset(x - 7, y)
    data.HealthBack.Size = UDim2.fromOffset(4, height)

    data.Health.Size = UDim2.new(
        1, 0,
        math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1),
        0
    )

    -- TRACER
    data.Tracer.Visible = S.TracerESP

    if S.TracerESP then
        local startPoint = Vector2.new(
            camera.ViewportSize.X / 2,
            camera.ViewportSize.Y
        )

        local endPoint = Vector2.new(top.X, bottom.Y)
        local delta = endPoint - startPoint

        data.Tracer.Position = UDim2.fromOffset(
            (startPoint.X + endPoint.X) / 2,
            (startPoint.Y + endPoint.Y) / 2
        )

        data.Tracer.Size = UDim2.fromOffset(delta.Magnitude, 2)
        data.Tracer.Rotation =
            math.deg(math.atan2(delta.Y, delta.X))

        data.Tracer.BackgroundColor3 = S.ESPColor
    end

    data.Highlight.Enabled = S.OutlineESP
    data.Highlight.OutlineColor = S.ESPColor
end

